# Copie ce fichier en ".env" (avec le point, sans ".example") à côté de app.py,
# ou renseigne la clé directement dans l'interface (Réglages avancés).
GEMINI_API_KEY=colle_ta_cle_ici

# --- Optionnel (les valeurs par défaut conviennent la plupart du temps) ---

# Nom du projet CapCut modèle :
# TEMPLATE_PROJECT=AutoShibi-V4

# Vidéo à monter (sinon : choisie dans l'interface, ou video.mkv à côté du logiciel) :
# VIDEO_FILE=video.mkv

# Dossier des projets CapCut, seulement si le logiciel ne le trouve pas tout seul :
# CAPCUT_PROJECTS_DIR=C:\Users\toi\AppData\Local\CapCut\User Data\Projects\com.lveditor.draft

# Modèles Gemini à essayer, dans l'ordre (virgules) — retire ceux qui répondent 404 :
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# --- Pistes audio séparées (réglables aussi dans l'interface) ---
# USE_AUDIO_TRACKS=1
# TRACK_AGENTOMG=2
# TRACK_MARVOUCH=3
# VAD_REL_DB=24
